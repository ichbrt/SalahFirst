<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Salah First does not track users, has no SDKs, and makes no network
	     requests. These declarations are therefore all negative except for the
	     one required-reason API the app genuinely uses. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: the app's own preferences. -->
				<string>CA92.1</string>
				<!-- 1C8F.1: preferences shared with this app's extensions
				     through the App Group container. -->
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
